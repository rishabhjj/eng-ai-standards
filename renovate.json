{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "go install (?<depName>[\\w./-]+)@(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "pip install (?:--quiet )?(?<depName>[\\w-]+)==(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
